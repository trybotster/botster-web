{
  "name": "botster-web",
  "version": "0.1.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [],
  "configuration": {
    "fields": [
      {
        "key": "remote_browser_rendezvous_enabled",
        "type": "boolean",
        "label": "Remote browser access",
        "description": "Local installed access stays available. Remote browser rendezvous through Botster Cloud requires opt-in, pairing, and device approval.",
        "default": { "type": "boolean", "value": false }
      }
    ]
  },
  "surfaces": [
    {
      "id": "dogfood-app",
      "kind": "app",
      "title": "botster-web",
      "description": "Descriptor-backed botster-web app surface for package launcher validation.",
      "order": 1,
      "category": "validation",
      "supports": ["render"]
    },
    {
      "id": "dogfood-settings",
      "kind": "settings",
      "title": "botster-web Settings",
      "description": "Descriptor-backed settings surface for package launcher validation.",
      "order": 2,
      "category": "validation",
      "supports": ["render"]
    }
  ],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "runnable_entrypoints": [
    {
      "id": "web-client",
      "kind": "web_app",
      "launch_mode": "background",
      "command": "node",
      "args": ["scripts/real-hub-dogfood-bridge.mjs"],
      "working_directory": { "policy": "package_root" },
      "injections": [
        {
          "kind": "hub_connection",
          "target": { "type": "environment", "name": "BOTSTER_HUB_CONNECTION" },
          "required": true,
          "description": "Structured hub connection descriptor supplied by hub-supervised package launch."
        },
        {
          "kind": "data_dir",
          "target": { "type": "environment", "name": "BOTSTER_HUB_DATA_DIR" },
          "required": true,
          "description": "Hub data directory supplied by hub-supervised package launch."
        },
        {
          "kind": "hub_socket",
          "target": { "type": "environment", "name": "BOTSTER_HUB_SOCKET" },
          "required": true,
          "description": "Existing hub daemon socket. Preferred when hub supervises botster-web."
        }
      ],
      "environment": [],
      "readiness": { "result_fields": ["local_url"] },
      "capabilities": [
        { "surface": "network", "scope": "localhost" }
      ],
      "may_supervise": true
    }
  ]
}
