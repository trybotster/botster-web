{
  "name": "botster-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "serve:package": "node scripts/local-package-server.mjs",
    "smoke:browser-runtime": "npm run build && node scripts/browser-runtime-smoke.mjs",
    "smoke:live-packaged-protocol": "npm run build && node scripts/live-packaged-protocol-harness.mjs",
    "smoke:workspaces-compat": "npm run build && BOTSTER_LIVE_REQUIRE_WORKSPACES=1 node scripts/live-packaged-protocol-harness.mjs",
    "smoke:workspaces-lifecycle": "npm run build && BOTSTER_LIVE_WORKSPACES_LIFECYCLE=1 node scripts/live-packaged-protocol-harness.mjs",
    "drive:workspaces-shared-hub-browser": "node scripts/workspaces-shared-hub-browser-driver.mjs",
    "smoke:workspaces-shared-hub-browser": "npm run build && node scripts/workspaces-shared-hub-browser-smoke.mjs",
    "smoke:live-packaged-protocol:caller-repeatability": "npm run build && node scripts/live-caller-owned-repeatability.mjs",
    "smoke:live-packaged-protocol:durable": "npm run build && BOTSTER_LIVE_DURABLE_STATE=1 node scripts/live-packaged-protocol-harness.mjs",
    "smoke:plugin-contract-matrix": "npm run build && BOTSTER_LIVE_CONTRACT_MATRIX=1 node scripts/live-packaged-protocol-harness.mjs",
    "smoke:plugin-payload-contract": "npm run build && BOTSTER_LIVE_CONTRACT_MATRIX=1 BOTSTER_LIVE_PAYLOAD_CONTRACT=1 BOTSTER_PLUGIN_PAYLOAD_CONTRACT_PACKAGE_PATH=fixtures/plugin-payload-contract node scripts/live-packaged-protocol-harness.mjs",
    "smoke:entity-options-reactive": "npm run build && BOTSTER_LIVE_ENTITY_OPTIONS=1 node scripts/live-packaged-protocol-harness.mjs",
    "smoke:mounted-terminal-keyboard": "node scripts/mounted-terminal-keyboard-smoke.mjs",
    "smoke:ghostsnp-grid": "node scripts/ghostsnp-grid-browser-smoke.mjs",
    "smoke:incremental-ghostsnp-attach": "node scripts/incremental-ghostsnp-attach-browser-smoke.mjs",
    "test": "node scripts/check-daemon-protocol-drift.mjs && node src/App.test.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false"
  },
  "dependencies": {
    "@ionic/react": "8.8.9",
    "@trybotster/terminal-protocol": "0.1.0",
    "@trybotster/ui-contract": "0.3.2",
    "ionicons": "8.0.13",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trybotster/hub-test-support": "0.1.36",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "playwright": "1.60.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16"
  }
}
